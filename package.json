{
  "name": "pista",
  "private": true,
  "description": "Open-source desktop agent app built on the Pi agent harness.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pista-AI/pista.git"
  },
  "homepage": "https://github.com/Pista-AI/pista#readme",
  "bugs": {
    "url": "https://github.com/Pista-AI/pista/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n host,ui -c blue,magenta \"PISTA_AUTH_PLAIN=${PISTA_AUTH_PLAIN:-1} pnpm --filter @pista/host dev\" \"pnpm --filter @pista/ui dev\"",
    "build": "pnpm --filter @pista/ui build && pnpm --filter @pista/host build",
    "start": "pnpm --filter @pista/host start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "package:desktop": "pnpm --filter @pista/desktop package",
    "policy:check": "pnpm --filter @pista/host policy:check",
    "eval:presets": "pnpm --filter @pista/host eval:presets",
    "analyze:session": "node scripts/analyze-session.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "undici@>=4.2.1 <6.29.1": "6.29.1",
      "zod@<4.6.6": "4.6.6",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0"
    }
  }
}
