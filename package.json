{
  "name": "pista",
  "private": true,
  "description": "Open-source desktop agent app built on the Pi agent harness.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pista-AI/pista.git"
  },
  "homepage": "https://github.com/Pista-AI/pista#readme",
  "bugs": {
    "url": "https://github.com/Pista-AI/pista/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n host,ui -c blue,magenta \"pnpm --filter @pista/host dev\" \"pnpm --filter @pista/ui dev\"",
    "build": "pnpm --filter @pista/ui build && pnpm --filter @pista/host build",
    "start": "pnpm --filter @pista/host start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "package:desktop": "pnpm --filter @pista/desktop package",
    "analyze:session": "node scripts/analyze-session.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.0"
}
