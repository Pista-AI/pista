<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID signed (hardened runtime) Pista.app. Used for the
  main app and, as the inherit file, for every helper and nested binary.

  allow-jit and allow-unsigned-executable-memory: V8 needs writable+executable memory
    in the renderer, GPU and utility helpers and in the main process. The agent host
    also runs inside the main executable (ELECTRON_RUN_AS_NODE=1), so it needs them too.

  Deliberately absent:
  - disable-library-validation: every Mach-O file (including native-module .node
    and .dylib files under Resources/host/node_modules) is re-signed with the same
    Developer ID identity, so library validation passes. Add it only if a native module
    that cannot be re-signed has to be loaded.
  - allow-dyld-environment-variables: nothing here relies on DYLD_* variables.
    ELECTRON_RUN_AS_NODE is read by Electron itself, not dyld.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
