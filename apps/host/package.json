{
  "name": "@pista/host",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Agent host sidecar: embeds the Pi agent and serves the Pista protocol over WebSocket.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/host.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/host.mjs --external:@earendil-works/* --external:ws --external:undici --external:typebox --external:pi-memory --external:pi-web-access",
    "policy:check": "tsx src/index.ts policy check",
    "typecheck": "tsc -p .",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@pista/local-runtime": "workspace:*",
    "@pista/pi-browser": "workspace:*",
    "@pista/protocol": "workspace:*",
    "pi-memory": "^0.4.2",
    "pi-web-access": "^0.44.0",
    "typebox": "^1.4.3",
    "undici": "7.30.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
